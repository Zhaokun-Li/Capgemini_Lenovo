    "# (4) 高价值差评用户识别 & 可疑差评初筛\n",
    "# 高价值差评（长文+低分+高有用数 → 最值得关注的真实反馈）\n",
    "df_negative['是否高价值'] = (df_negative['评论长度'] >= 30) & (df_negative['评分'] <= 2) & (df_negative['有用数'] >= 3)\n",
